rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // 🛡️ HELPER FUNCTIONS
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isMasterAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'master_admin' || 
        !('role' in request.auth.token) // Default owner fallback
      );
    }
    
    function isOrgAdmin() {
      return isAuthenticated() && (
        request.auth.token.role in ['master_admin', 'admin'] || 
        !('role' in request.auth.token) // Default owner fallback
      );
    }

    // ==========================================
    // 👤 1. UNIVERSAL USER PROFILES & ONBOARDING
    // Path: users/{userId}
    // ==========================================
    match /users/{userId} {
      allow read, write: if true;
    }

    // ==========================================
    // 🌐 2. MULTI-BUILDING PORTFOLIOS
    // Path: portfolios/{portfolioId}
    // ==========================================
    match /portfolios/{portfolioId} {
      allow read, write: if true;
    }

    // ==========================================
    // 👥 3. GLOBAL STAFF ACCOUNTS
    // Path: staff_accounts/{staffId}
    // ==========================================
    match /staff_accounts/{staffId} {
      allow read, write: if true;
    }

    // ==========================================
    // 🏢 4. PROPERTIES & ALL SUB-COLLECTIONS
    // Path: properties/{propertyId}/{document=**}
    // ==========================================
    match /properties/{propertyId}/{document=**} {
      allow read, write: if true;
    }
  }
}
